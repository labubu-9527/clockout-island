{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clockout-island",
  "version": "1.0.0",
  "identifier": "com.focusd.island",
  "build": {
    "beforeDevCommand": "node scripts/stop-running-island.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "岛点下班",
        "width": 960,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "translation",
        "title": "岛点下班 翻译",
        "url": "index.html?window=translation",
        "width": 480,
        "height": 640,
        "minWidth": 480,
        "minHeight": 380,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "clipboard",
        "create": false,
        "title": "岛点下班",
        "url": "index.html?window=clipboard",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "settings",
        "create": false,
        "title": "岛点下班",
        "url": "index.html?window=settings",
        "width": 1180,
        "height": 800,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/labubu-9527/clockout-island/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/labubu-9527/clockout-island/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/labubu-9527/clockout-island/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (C) 2026 flyl1u and contributors; fork maintained by labubu-9527",
    "resources": {
      "../LICENSE": "licenses/LICENSE-GPL-3.0.txt",
      "../docs/third-party-licenses.md": "licenses/THIRD-PARTY-NOTICES.md",
      "../src/assets/pet/LICENSE": "licenses/LICENSE-island-pet.txt",
      "../src/assets/fonts/OFL-Fusion-Pixel.txt": "licenses/OFL-Fusion-Pixel.txt",
      "../src/assets/fonts/LICENSES/galmuri/LICENSE.txt": "licenses/LICENSE-galmuri.txt",
      "../src/assets/fonts/LICENSES/cubic-11/OFL.txt": "licenses/OFL-cubic-11.txt",
      "../src/assets/fonts/LICENSES/ark-pixel/OFL.txt": "licenses/OFL-ark-pixel.txt",
      "resources/media-plugins/BetterNCMII.dll": "media-plugins/BetterNCMII.dll",
      "resources/media-plugins/BetterNCMII86.dll": "media-plugins/BetterNCMII86.dll",
      "resources/media-plugins/InfLink-rs.plugin": "media-plugins/InfLink-rs.plugin",
      "resources/media-plugins/LICENSE-GPL-3.0.txt": "media-plugins/LICENSE-GPL-3.0.txt",
      "resources/media-plugins/README.md": "media-plugins/README.md"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
